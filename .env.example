# Lumine AI Environment Variables

# The Secret Key for signing JWT tokens (Required)
# Generate a secure key using: openssl rand -hex 32
SECRET_KEY=your_super_secret_key_here

# Google Gemini API Key for AI Insights (Required)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Gemini Model Name (Optional, defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Hugging Face Token (Required for Image Inference)
HF_TOKEN=your_hf_token_here

# Hugging Face Image Model ID (Optional, defaults to Jayanth2002/dinov2-base-finetuned-SkinDisease)
# NOTE: Uses the free Serverless Inference API which may have rate limits or cold starts.
# You can upgrade to a Dedicated Inference Endpoint in production.
HF_IMAGE_MODEL=Jayanth2002/dinov2-base-finetuned-SkinDisease

# Allowed origins for CORS (Optional, defaults to localhost:3000)
# Comma-separated list of URLs
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database URL (Optional, defaults to local SQLite)
# For production PostgreSQL: postgresql://user:password@localhost/dbname
DATABASE_URL=sqlite:///./lumine.db
